# Copy to .env and fill in. .env is gitignored; this file is not.
# A real environment variable overrides anything set here.

# Board to scrape.
PINTEREST_BOARD_URL=https://www.pinterest.com/<user>/<board>/

# Where to cache the signed-in Pinterest session. Pinterest shows a signup wall
# to logged-out visitors, so the first run pauses for a manual sign-in and
# writes this file. It holds live Pinterest cookies and is gitignored.
# PINTEREST_STORAGE_STATE_FILE=C:/Users/<you>/.secrets/pinterest_storage_state.json

# Album to look up by name once iCloud Photos is open.
ICLOUD_ALBUM_NAME=Pinterest wallpapers

# Optional deep link straight to an album, which skips the name lookup.
# The UUID identifies your private album — keep it out of the repo.
# Find it by opening the album in iCloud Photos and copying the address bar.
ICLOUD_ALBUM_URL=

# Where to cache the signed-in iCloud session. This file holds live Apple auth
# cookies. It is gitignored by default; point it outside the repo if you prefer.
# ICLOUD_STORAGE_STATE_FILE=C:/Users/<you>/.secrets/icloud_storage_state.json
